# Optional. urlscan's current Search API documentation requires an API key.
URLSCAN_API_KEY=

# Optional. Authenticated GitHub API requests have a higher limit.
GITHUB_TOKEN=

# Required for protected cron endpoints.
CRON_SECRET=change-me

# Optional comma-separated origin allow-list for CORS.
ALLOWED_ORIGINS=https://your-project.vercel.app

# Collector controls.
COLLECTOR_MAX_PER_HOST=24
COLLECTOR_MAX_TOTAL=180
FETCH_TIMEOUT_MS=7000
CACHE_SECONDS=300
USER_AGENT=SiteScoutBot/1.0 (+https://example.com/about)
